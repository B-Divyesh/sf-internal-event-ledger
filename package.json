{
  "name": "internal-event-ledger",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "cargo run",
    "build": "vite build",
    "test": "vitest run && node --test scripts/container-contract.test.mjs scripts/forbidden-resource.test.mjs && cargo test --locked && npm run test:storage && npm run test:claims",
    "test:frontend": "vitest run",
    "test:forbidden-resources": "node --test scripts/forbidden-resource.test.mjs",
    "test:a11y": "node scripts/axe.mjs",
    "test:e2e": "node scripts/smoke.mjs",
    "test:storage": "cargo build --locked && node --test scripts/startup-storage.test.mjs",
    "test:claims": "npm run build && cargo build --locked && node --no-warnings scripts/claims.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@types/node": "^24.3.0",
    "playwright": "1.58.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
